#!/usr/bin/env bash
# app: Webseiten und Programme ueber Kurznamen starten.
#
#   app yt            YouTube als eigenes App-Fenster
#   app dc            Discord starten
#   app               Auswahl mit fzf
#   app example.com   beliebige Seite als App-Fenster
#   app --list        alle Kurznamen anzeigen
#
# Kurznamen stehen in ~/.config/app/apps.conf (Format dort beschrieben).
# Browser: $APP_BROWSER, sonst helium-browser, chromium, google-chrome-stable.

set -euo pipefail

CONF="${APP_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/app/apps.conf}"

entries() {
  [[ -f $CONF ]] || { echo "Keine Konfiguration: $CONF" >&2; exit 1; }
  sed 's/#.*//' "$CONF" | awk 'NF >= 2 { name=$1; $1=""; sub(/^ +/, ""); print name "\t" $0 }'
}

lookup() { entries | awk -F'\t' -v n="$1" '$1 == n { print $2; exit }'; }

browser() {
  local b
  for b in ${APP_BROWSER:-} helium-browser chromium google-chrome-stable brave; do
    command -v "$b" >/dev/null && { echo "$b"; return; }
  done
  echo "Kein Chromium-Browser gefunden (APP_BROWSER setzen)" >&2
  exit 1
}

launch() { setsid -f "$@" >/dev/null 2>&1 </dev/null; }

open_target() {
  local target=$1
  case $target in
    http://*|https://*) launch "$(browser)" --app="$target" ;;
    desktop:*)          launch gtk-launch "${target#desktop:}" ;;
    *)                  launch bash -c "$target" ;;
  esac
}

case ${1:-} in
  -h|--help) sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 0 ;;
  --list)    entries | awk -F'\t' '{ printf "%-10s %s\n", $1, $2 }'; exit 0 ;;
  --complete) entries; exit 0 ;;   # fuer die Fish-Vervollstaendigung
  "")
    if [[ -t 0 ]] && command -v fzf >/dev/null; then
      sel=$(entries | awk -F'\t' '{ printf "%-10s %s\n", $1, $2 }' |
        fzf --prompt="app> " --height=40% --reverse --border) || exit 1
      open_target "$(lookup "${sel%% *}")"
    else
      entries | awk -F'\t' '{ printf "%-10s %s\n", $1, $2 }'
    fi
    exit 0
    ;;
esac

name=$1
if target=$(lookup "$name") && [[ -n $target ]]; then
  open_target "$target"
elif [[ $name == *.* ]]; then
  # sieht aus wie eine Domain
  [[ $name == http* ]] || name="https://$name"
  open_target "$name"
else
  echo "Unbekannter Kurzname: $name" >&2
  echo "Verfuegbar: $(entries | cut -f1 | paste -sd ' ')" >&2
  exit 1
fi
