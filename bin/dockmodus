#!/usr/bin/env python3
"""dockmodus: linke App-Leiste <-> Dock unten (wie macOS) umschalten.

  dockmodus          umschalten                         SUPER+ALT+B
  dockmodus dock     Dock unten, App-Leiste links aus
  dockmodus leiste   App-Leiste links, Dock aus
  dockmodus status   zeigt den aktuellen Modus

Beim Umschalten werden die angepinnten Apps mitgenommen: Wer gerade aktiv ist,
gibt seine Pins an den anderen weiter (Leiste: barPinnedApps, Dock: dockPins).
"""
import json
import os
import subprocess
import sys
from pathlib import Path

CFG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "dms" / "settings.json"
SESSION = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "DankMaterialShell" / "session.json"
BAR_ID, DOCK_ID = "leftDock", "dock"


def load(p):
    return json.loads(p.read_text())


def save(p, data):
    tmp = p.with_suffix(".tmp-dockmodus")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    tmp.replace(p)  # atomar, DMS liest nie eine halbe Datei


def parts(cfg):
    bar = next((b for b in cfg.get("barConfigs", []) if b.get("id") == BAR_ID), None)
    dock = next((d for d in cfg.get("dockConfigs", []) if d.get("id") == DOCK_ID), None)
    if not bar or not dock:
        sys.exit(f"dockmodus: Leiste '{BAR_ID}' oder Dock '{DOCK_ID}' fehlt in {CFG}")
    return bar, dock


def main(arg):
    cfg = load(CFG)
    bar, dock = parts(cfg)
    current = "dock" if dock.get("enabled") else "leiste"
    if arg == "status":
        print(current)
        return 0
    want = arg if arg in ("dock", "leiste") else ("leiste" if current == "dock" else "dock")
    if want == current:
        print(f"schon {current}")
        return 0

    ses = load(SESSION)
    pins = ses.setdefault("dockPins", {})
    if want == "dock":
        pins[DOCK_ID] = list(ses.get("barPinnedApps", []))
    else:
        ses["barPinnedApps"] = list(pins.get(DOCK_ID, [])) or ses.get("barPinnedApps", [])
    save(SESSION, ses)

    bar["enabled"] = want == "leiste"
    dock["enabled"] = want == "dock"
    dock["position"] = 1  # unten
    dock["mode"] = "dock"  # mittig wie macOS statt volle Breite (taskbar)
    save(CFG, cfg)
    # Leiste/Dock uebernimmt DMS live, die Pins (session.json) liest es nur beim Start
    subprocess.run(["dms", "restart"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    subprocess.run(["notify-send", "-a", "Dock", "-t", "1500", "Dock-Modus",
                    "Dock unten" if want == "dock" else "App-Leiste links"], check=False)
    print(want)
    return 0


if __name__ == "__main__":
    a = sys.argv[1] if len(sys.argv) > 1 else ""
    if a in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0)
    sys.exit(main(a))
